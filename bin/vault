#!/usr/bin/env bash
#
# Self-bootstrapping Vault wrapper
#
# This script ensures all dependencies are installed before running vault.
# On a fresh macOS system with just bash and curl, this will:
# 1. Install Homebrew (if needed)
# 2. Install git, mise (if needed)
# 3. Build the vault escript (if needed)
# 4. Run the vault command with all arguments
#
# Usage: ./vault <command> [options]
#

set -euo pipefail

RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
NC='\033[0m' # No Color

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
VAULT_ESCRIPT="$SCRIPT_DIR/.vault-escript"
RELOAD=false

# Check for --dev flag
for arg in "$@"; do
    if [ "$arg" = "--dev" ]; then
        RELOAD=true
        break
    fi
done

if [ ! -f "$VAULT_ESCRIPT" ]; then
    echo -e "${BLUE}╔═══════════════════════════════════════════════════════════╗${NC}"
    echo -e "${BLUE}║     Vault Self-Bootstrap                                  ║${NC}"
    echo -e "${BLUE}╚═══════════════════════════════════════════════════════════╝${NC}"
    echo ""
    echo -e "${YELLOW}First run detected. Installing dependencies...${NC}"
    echo ""

    if ! command -v brew &> /dev/null; then
        echo -e "${YELLOW}==> Installing Homebrew${NC}"
        /bin/bash -c "$(curl -fsSL https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh)"

        if [ -f "/opt/homebrew/bin/brew" ]; then
            eval "$(/opt/homebrew/bin/brew shellenv)"
        elif [ -f "/usr/local/bin/brew" ]; then
            eval "$(/usr/local/bin/brew shellenv)"
        fi
        echo ""
    else
        echo -e "${GREEN}==> Homebrew already installed${NC}"
        echo ""
    fi

    if ! command -v git &> /dev/null; then
        echo -e "${YELLOW}==> Installing git${NC}"
        brew install git
        echo ""
    else
        echo -e "${GREEN}==> git already installed${NC}"
        echo ""
    fi

    if ! command -v mise &> /dev/null; then
        echo -e "${YELLOW}==> Installing mise${NC}"
        brew install mise
        echo ""
    else
        echo -e "${GREEN}==> mise already installed${NC}"
        echo ""
    fi

    echo -e "${YELLOW}==> Building vault${NC}"
    cd "$SCRIPT_DIR"

    mise install
    mise exec -- mix deps.get
    mise exec -- mix escript.build
    chmod +x "$VAULT_ESCRIPT"

    echo ""
    echo -e "${GREEN}╔═══════════════════════════════════════════════════════════╗${NC}"
    echo -e "${GREEN}║     Bootstrap Complete!                                  ║${NC}"
    echo -e "${GREEN}╚═══════════════════════════════════════════════════════════╝${NC}"
    echo ""
fi

if [ ! -f "$VAULT_ESCRIPT" ]; then
    echo -e "${RED}Error: Failed to build vault escript${NC}"
    exit 1
fi

if [ "$RELOAD" = true ]; then
    echo -e "${YELLOW}==> Rebuilding vault (--dev mode)${NC}"
    mise exec -- mix escript.build
    chmod +x "$VAULT_ESCRIPT"
    echo ""
fi

exec "$VAULT_ESCRIPT" "$@"

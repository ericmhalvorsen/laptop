#!/bin/bash

matching=$(ps -ef | grep "$1" | grep -v grep | grep -v "murder $1")
if [ -n "$matching" ]; then
  echo "Killing processes:"
  echo "$matching" | awk '{printf "  %s (%s)\n", $2, $8}'
  processes=$(echo "$matching" | awk "{print \$2}")
  echo "$processes" | xargs kill -9 2>/dev/null && echo "Done." || echo "Done (some processes already terminated)."
else
  echo "No processes matching '$1' found."
fi

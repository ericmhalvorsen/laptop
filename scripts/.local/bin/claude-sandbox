#!/usr/bin/env bash
set -euo pipefail

# Docker AI Sandbox launcher for Censinet
#
# Usage:
#   bin/sandbox                              # Resume or create sandbox, launch Claude
#   bin/sandbox "fix the bug"                # Launch with a prompt
#   bin/sandbox --cycles PLAN.md             # Autonomous loop executing a plan
#   bin/sandbox --cycles PLAN.md --max-runtime 30m --max-turns 20
#   bin/sandbox --clean                      # Remove existing sandbox and recreate
#   bin/sandbox --exec                       # Shell into the running sandbox
#   bin/sandbox --ls                         # List all sandboxes
#   bin/sandbox --rm                         # Remove the censinet sandbox
#   bin/sandbox --inspect                    # Inspect the censinet sandbox
#   bin/sandbox --detach                     # Create sandbox without interactive agent
#   bin/sandbox --debug                      # Run with debug logging

SANDBOX_NAME="censinet"
PROJECT_DIR="$(cd "$(dirname "$0")/.." && pwd)"
CLAUDE_HOME="${HOME}/.claude"

RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
NC='\033[0m'

log()  { echo -e "${GREEN}[sandbox]${NC} $*"; }
warn() { echo -e "${YELLOW}[sandbox]${NC} $*"; }
err()  { echo -e "${RED}[sandbox]${NC} $*" >&2; }
cyc()  { echo -e "${BLUE}[cycles]${NC} $*"; }

# --- Helpers ---

sandbox_exists() {
  docker sandbox inspect "$SANDBOX_NAME" &>/dev/null
}

sandbox_status() {
  docker sandbox inspect "$SANDBOX_NAME" 2>/dev/null \
    | grep -o '"status": *"[^"]*"' | head -1 | cut -d'"' -f4
}

check_api_key() {
  if [[ -z "${ANTHROPIC_API_KEY:-}" ]]; then
    err "ANTHROPIC_API_KEY is not set in your environment."
    err "The Docker sandbox daemon may not pick it up from a session-only export."
    err ""
    err "Add to ~/.zshrc:  export ANTHROPIC_API_KEY=sk-ant-..."
    err "Then:  source ~/.zshrc && restart Docker Desktop"
    err ""
    err "Or run:  bin/sandbox-setup"
    return 1
  fi
}

check_docker() {
  if ! command -v docker &>/dev/null; then
    err "Docker is not installed or not in PATH."
    return 1
  fi
  if ! docker sandbox version &>/dev/null; then
    err "Docker sandbox plugin not available. Need Docker Desktop >= 4.58."
    return 1
  fi
}

ensure_sandbox() {
  if ! sandbox_exists; then
    log "Creating sandbox '$SANDBOX_NAME' (detached)..."
    docker sandbox run \
      --name "$SANDBOX_NAME" \
      -w "$PROJECT_DIR" \
      -v "${CLAUDE_HOME}:${CLAUDE_HOME}:ro" \
      -e "ANTHROPIC_API_KEY=${ANTHROPIC_API_KEY}" \
      --detached \
      claude
  fi

  local status
  status=$(sandbox_status)
  if [[ "$status" != "running" ]]; then
    log "Sandbox exists but status is '$status'. Removing and recreating..."
    docker sandbox rm "$SANDBOX_NAME"
    docker sandbox run \
      --name "$SANDBOX_NAME" \
      -w "$PROJECT_DIR" \
      -v "${CLAUDE_HOME}:${CLAUDE_HOME}:ro" \
      -e "ANTHROPIC_API_KEY=${ANTHROPIC_API_KEY}" \
      --detached \
      claude
  fi
}

# Parse duration strings like "30m", "2h", "90s" into seconds
parse_duration() {
  local input="$1"
  local num="${input%[smhSMH]}"
  local unit="${input##*[0-9]}"
  case "${unit,,}" in
    s|"") echo "$num" ;;
    m)    echo $((num * 60)) ;;
    h)    echo $((num * 3600)) ;;
    *)    err "Invalid duration: $input (use s/m/h)"; return 1 ;;
  esac
}

# --- Commands ---

cmd_ls() {
  docker sandbox ls
}

cmd_rm() {
  if sandbox_exists; then
    log "Removing sandbox '$SANDBOX_NAME'..."
    docker sandbox rm "$SANDBOX_NAME"
    log "Done."
  else
    warn "No sandbox named '$SANDBOX_NAME' found."
  fi
}

cmd_inspect() {
  docker sandbox inspect "$SANDBOX_NAME"
}

cmd_exec() {
  if ! sandbox_exists; then
    err "No sandbox named '$SANDBOX_NAME'. Run bin/sandbox first."
    return 1
  fi
  log "Entering sandbox shell..."
  docker sandbox exec -it "$SANDBOX_NAME" bash
}

cmd_run() {
  local clean=false
  local detach=false
  local debug=false
  local prompt=""

  while [[ $# -gt 0 ]]; do
    case "$1" in
      --clean)  clean=true; shift ;;
      --detach) detach=true; shift ;;
      --debug)  debug=true; shift ;;
      *)        prompt="$1"; shift ;;
    esac
  done

  check_api_key
  check_docker

  if $clean && sandbox_exists; then
    log "Removing existing sandbox..."
    docker sandbox rm "$SANDBOX_NAME"
  fi

  local args=(
    --name "$SANDBOX_NAME"
    -w "$PROJECT_DIR"
    -v "${CLAUDE_HOME}:${CLAUDE_HOME}:ro"
    -e "ANTHROPIC_API_KEY=${ANTHROPIC_API_KEY}"
  )

  if $debug; then
    args=(-D "${args[@]}")
  fi

  if $detach; then
    args+=(--detached)
  fi

  log "Launching sandbox '$SANDBOX_NAME'..."
  log "  Project:  $PROJECT_DIR"
  log "  Config:   $CLAUDE_HOME (read-only)"

  if [[ -n "$prompt" ]]; then
    log "  Prompt:   ${prompt:0:80}..."
    docker sandbox run "${args[@]}" claude -- "$prompt"
  else
    docker sandbox run "${args[@]}" claude
  fi
}

# --- Cycles ---

cmd_cycles() {
  local plan_file=""
  local max_turns=0
  local max_runtime=0
  local max_budget=""
  local model=""
  local debug=false
  local clean=false

  while [[ $# -gt 0 ]]; do
    case "$1" in
      --max-turns)   max_turns="$2"; shift 2 ;;
      --max-runtime) max_runtime=$(parse_duration "$2"); shift 2 ;;
      --max-budget)  max_budget="$2"; shift 2 ;;
      --model)       model="$2"; shift 2 ;;
      --debug)       debug=true; shift ;;
      --clean)       clean=true; shift ;;
      *)
        if [[ -z "$plan_file" ]]; then
          plan_file="$1"; shift
        else
          err "Unknown argument: $1"; return 1
        fi
        ;;
    esac
  done

  if [[ -z "$plan_file" ]]; then
    err "Usage: bin/sandbox --cycles PLAN.md [--max-turns N] [--max-runtime 30m] [--max-budget 5.00]"
    return 1
  fi

  if [[ ! -f "$plan_file" ]]; then
    err "Plan file not found: $plan_file"
    return 1
  fi

  # Resolve to absolute path
  plan_file="$(cd "$(dirname "$plan_file")" && pwd)/$(basename "$plan_file")"
  local plan_dir
  plan_dir="$(dirname "$plan_file")"
  local plan_name
  plan_name="$(basename "$plan_file" .md)"
  local status_file="${plan_dir}/${plan_name}.status.json"
  local stop_file="${PROJECT_DIR}/.stop"

  check_api_key
  check_docker

  # Clean existing sandbox if requested
  if $clean && sandbox_exists; then
    log "Removing existing sandbox..."
    docker sandbox rm "$SANDBOX_NAME"
  fi

  ensure_sandbox

  # Initialize status file if it doesn't exist
  if [[ ! -f "$status_file" ]]; then
    cat > "$status_file" <<'STATUSEOF'
{
  "turn": 0,
  "phase": "starting",
  "current_task": null,
  "completed": [],
  "blockers": [],
  "exit": false,
  "exit_reason": null
}
STATUSEOF
    cyc "Initialized $status_file"
  fi

  # Clean up any stale stop file
  rm -f "$stop_file"

  # Create working branch
  local branch="cycles/${plan_name}"
  local current_branch
  current_branch=$(git -C "$PROJECT_DIR" rev-parse --abbrev-ref HEAD)
  if [[ "$current_branch" != "$branch" ]]; then
    cyc "Creating branch '$branch'..."
    git -C "$PROJECT_DIR" checkout -b "$branch" 2>/dev/null || git -C "$PROJECT_DIR" checkout "$branch"
  fi

  # Build the system prompt
  local system_prompt
  system_prompt=$(cat <<'SYSEOF'
You are running in autonomous "cycles" mode inside a Docker sandbox.

## Your workflow each turn

1. Read the plan file and status file (paths provided in the prompt)
2. Identify the next incomplete task from the plan
3. Execute that task — write code, run tests, fix issues
4. Update the plan file: check off completed items with [x], mark current with [~]
5. Write the status file with your progress (valid JSON, same schema)
6. Do NOT make git commits — the orchestrator handles that

## Status file schema

```json
{
  "turn": <number>,
  "phase": "implementing" | "testing" | "debugging" | "complete",
  "current_task": "<task id and description>",
  "completed": ["<task id>", ...],
  "blockers": ["<description>", ...],
  "exit": false,
  "exit_reason": null
}
```

Set `"exit": true` when ALL tasks are complete or you hit an unrecoverable blocker.
Set `"exit_reason"` to a short description (e.g. "all tasks complete", "blocked: need API credentials").

## Rules

- Focus on ONE task per turn. Do it well.
- Run tests after changes when possible.
- If stuck on a task after a solid attempt, note the blocker in status and move to the next task.
- Do not create documentation files unless the plan asks for it.
- Do not refactor code beyond what the current task requires.
- Be concise in plan annotations. A few words per checkbox, not paragraphs.
SYSEOF
)

  local start_time
  start_time=$(date +%s)
  local turn=0

  # Read current turn from status file
  if command -v jq &>/dev/null; then
    turn=$(jq -r '.turn // 0' "$status_file" 2>/dev/null || echo 0)
  fi

  cyc "Starting cycles"
  cyc "  Plan:        $plan_file"
  cyc "  Status:      $status_file"
  cyc "  Branch:      $branch"
  cyc "  Max turns:   ${max_turns:-unlimited}"
  cyc "  Max runtime: ${max_runtime:-unlimited}s"
  cyc "  Stop file:   $stop_file (touch to stop)"
  echo ""

  # --- Main loop ---
  while true; do
    turn=$((turn + 1))

    # --- Exit condition checks ---

    # Stop file
    if [[ -f "$stop_file" ]]; then
      cyc "Stop file detected. Finishing."
      rm -f "$stop_file"
      break
    fi

    # Max turns
    if [[ "$max_turns" -gt 0 && "$turn" -gt "$max_turns" ]]; then
      cyc "Max turns ($max_turns) reached."
      break
    fi

    # Max runtime
    if [[ "$max_runtime" -gt 0 ]]; then
      local elapsed=$(( $(date +%s) - start_time ))
      if [[ "$elapsed" -ge "$max_runtime" ]]; then
        cyc "Max runtime (${max_runtime}s) reached after ${elapsed}s."
        break
      fi
    fi

    # Status file says exit
    if command -v jq &>/dev/null; then
      local should_exit
      should_exit=$(jq -r '.exit // false' "$status_file" 2>/dev/null || echo "false")
      if [[ "$should_exit" == "true" ]]; then
        local reason
        reason=$(jq -r '.exit_reason // "unknown"' "$status_file" 2>/dev/null || echo "unknown")
        cyc "Plan signaled exit: $reason"
        break
      fi
    fi

    # --- Execute turn ---

    cyc "=== Turn $turn ==="

    local user_prompt
    user_prompt="Execute the next task from the plan.

Plan file: ${plan_file}
Status file: ${status_file}

Read both files, do the work, then update both files."

    # Build claude args
    local claude_args=(
      -p "$user_prompt"
      --append-system-prompt "$system_prompt"
      --output-format json
      --dangerously-skip-permissions
    )

    if [[ -n "$max_budget" ]]; then
      claude_args+=(--max-budget-usd "$max_budget")
    fi

    if [[ -n "$model" ]]; then
      claude_args+=(--model "$model")
    fi

    # Run Claude inside the sandbox
    local output
    local exit_code=0
    output=$(docker sandbox exec "$SANDBOX_NAME" \
      claude "${claude_args[@]}" 2>&1) || exit_code=$?

    if [[ "$exit_code" -ne 0 ]]; then
      cyc "Turn $turn exited with code $exit_code"
      if [[ "$exit_code" -eq 1 ]]; then
        cyc "Claude encountered an error. Output:"
        echo "$output" | tail -20
        cyc "Pausing 10s before retry..."
        sleep 10
        continue
      else
        cyc "Fatal error. Stopping."
        echo "$output" | tail -20
        break
      fi
    fi

    # Extract result summary from JSON output
    local result=""
    if command -v jq &>/dev/null && echo "$output" | jq -e '.result' &>/dev/null; then
      result=$(echo "$output" | jq -r '.result' | head -5)
      cyc "Result: ${result:0:200}"
    fi

    # Commit changes
    local changed_files
    changed_files=$(git -C "$PROJECT_DIR" status --porcelain 2>/dev/null || true)
    if [[ -n "$changed_files" ]]; then
      git -C "$PROJECT_DIR" add -A
      local commit_msg="cycles: turn ${turn}"
      # Try to get current task from status
      if command -v jq &>/dev/null; then
        local task
        task=$(jq -r '.current_task // empty' "$status_file" 2>/dev/null || true)
        if [[ -n "$task" ]]; then
          commit_msg="cycles: turn ${turn} — ${task}"
        fi
      fi
      git -C "$PROJECT_DIR" commit -m "$commit_msg" --quiet 2>/dev/null || true
      cyc "Committed: $commit_msg"
    else
      cyc "No changes to commit."
    fi

    echo ""
  done

  # --- Summary ---
  echo ""
  cyc "=== Cycles complete ==="
  cyc "  Turns:   $turn"
  cyc "  Branch:  $branch"
  cyc "  Status:  $status_file"

  local elapsed=$(( $(date +%s) - start_time ))
  local mins=$((elapsed / 60))
  local secs=$((elapsed % 60))
  cyc "  Runtime: ${mins}m ${secs}s"

  if command -v jq &>/dev/null; then
    local final_phase
    final_phase=$(jq -r '.phase // "unknown"' "$status_file" 2>/dev/null || echo "unknown")
    local completed_count
    completed_count=$(jq -r '.completed | length' "$status_file" 2>/dev/null || echo "?")
    cyc "  Phase:   $final_phase"
    cyc "  Done:    $completed_count tasks"

    local blockers
    blockers=$(jq -r '.blockers | length' "$status_file" 2>/dev/null || echo "0")
    if [[ "$blockers" -gt 0 ]]; then
      cyc "  Blockers:"
      jq -r '.blockers[]' "$status_file" 2>/dev/null | while read -r b; do
        cyc "    - $b"
      done
    fi
  fi

  echo ""
  cyc "Review: git log --oneline ${branch}"
  cyc "Diff:   git diff main...${branch}"
}

# --- Main ---

case "${1:-}" in
  --ls)      cmd_ls ;;
  --rm)      cmd_rm ;;
  --inspect) cmd_inspect ;;
  --exec)    cmd_exec ;;
  --cycles)  shift; cmd_cycles "$@" ;;
  --help|-h)
    sed -n '/^# Usage:/,/^$/p' "$0" | sed 's/^# *//' | sed '/^$/d'
    ;;
  *)
    cmd_run "$@"
    ;;
esac
